<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule 1: Normal Users see only their own Site Visits -->
        <record id="site_visit_personal_rule" model="ir.rule">
            <field name="name">Personal Site Visits Only</field>
            <field name="model_id" ref="model_site_visit"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rule 2: Settings/System Administrators see all Site Visits -->
        <record id="site_visit_admin_all_rule" model="ir.rule">
            <field name="name">All Site Visits (Admin/Manager)</field>
            <field name="model_id" ref="model_site_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>